{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "audit:sec": "npm audit --audit-level=high",
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push --force",
    "db:rollback": "tsx scripts/rollback.ts",
    "db:tenancy": "psql -h 127.0.0.1 -U postgres -d app_db -f scripts/sql/post-migrate/010_row_level_security.sql",
    "dev": "next dev",
    "lint": "eslint .",
    "seed:auth": "tsx scripts/seed-auth.ts",
    "start": "next start",
    "test:eudr": "tsx scripts/check-eudr-rules.ts",
    "typecheck": "tsc --noEmit",
    "check:seed": "tsx --conditions=react-server scripts/check-seed-securite.ts",
    "check:eudr": "tsx --conditions=react-server scripts/check-eudr-rules.ts",
    "check:topologie": "tsx --conditions=react-server scripts/check-gis-topology.ts",
    "check:regles": "tsx --conditions=react-server scripts/check-p106-regles.ts",
    "check:csv": "tsx --conditions=react-server scripts/check-csv-latin.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:e2e": "tsx --conditions=react-server scripts/check-bout-en-bout.ts",
    "check:e2e:complet": "tsx --conditions=react-server scripts/check-bout-en-bout.ts --complet",
    "check:derive-schema": "drizzle-kit generate --name derive && git diff --exit-code --quiet drizzle/ || (echo \"DÉRIVE : drizzle/ modifié par generate — une migration manque\" && exit 1)",
    "check:version": "tsx --conditions=react-server scripts/check-version.ts",
    "check:schema": "drizzle-kit generate --name ci-derive > /tmp/schema-gen.log 2>&1; grep -q \"No schema changes\" /tmp/schema-gen.log || (cat /tmp/schema-gen.log && echo \"DÉRIVE : src/db/schema.ts et drizzle/ ne concordent pas — une migration manque\" && exit 1)",
    "check:docs": "tsx --conditions=react-server scripts/check-docs.ts",
    "check:banc-pays": "tsx --conditions=react-server scripts/check-banc-pays.ts"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "eslint-plugin-react-hooks": "6.1.1",
    "source-map-js": "^1.2.2",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "next": "16.4.5",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "version": "0.1.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
