# Base de données (PostgreSQL)
#
# ⚠️ Deux connexions, deux rôles. La confusion entre les deux est la
#   défaillance la plus silencieuse de ce produit : l'URL fournie par
#   l'hébergeur est celle du propriétaire, laquelle porte l'attribut
#   BYPASSRLS et contourne donc la RLS. L'application verrait toutes les
#   organisations sans jamais lever la moindre erreur — mesuré sur Neon le
#   02/10/2026. La RLS n'est alors plus qu'un décor.
#
#   DATABASE_URL       : rôle APPLICATIF      — exécution du produit.
#                        SELECT / INSERT / UPDATE, ni DELETE ni DDL,
#                        RLS appliquée à chaque requête.
#   DATABASE_URL_ADMIN : rôle d'ADMINISTRATION — migrations, amorçage des
#                        comptes, purge de rétention. Rien d'autre.
#
# En développement local les deux pointent vers le superutilisateur : le
# contrôle de démarrage (src/instrumentation.ts) avertit sans interrompre.
# En production, un rôle non conforme empêche le serveur de démarrer.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Contrôle du rôle de connexion au démarrage. Le désactiver ne corrige rien :
# cela permet seulement de redémarrer un service en incident, en connaissance
# de cause. L'avertissement est écrit à chaque démarrage et /api/health
# continue de signaler l'anomalie (composant « role_base »).
# GF_CONTROLE_ROLE=off

# Authentification (P0-01)
# Secret de signature des jetons d'accès. Au moins 32 caractères, aléatoire.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# OBLIGATOIRE en production : l'application refuse de démarrer sans lui.
AUTH_SECRET=

# Analyse satellite Global Forest Watch (P0-04)
# Sans clé, l'analyse est refusée explicitement (aucun repli sur une simulation).
GFW_API_KEY=
GFW_API_BASE=https://data-api.globalforestwatch.org

# ---------------------------------------------------------------------------
# Supervision (P1-06)
# Aucune de ces variables n'est obligatoire : le produit démarre sans
# supervision, et c'est volontaire — un service qui refuse de démarrer parce
# qu'un collecteur est absent est un service qu'on ne peut plus redémarrer en
# plein incident.
#
# ⚠️ Les transports Sentry, OpenTelemetry et PagerDuty n'ont JAMAIS été exécutés
#   contre leur service réel. Ils sont livrés marqués non validés et restent
#   inactifs. Les activer suppose d'avoir joué la recette correspondante :
#   infra/supervision/mise-en-route.md §5.
#
# Procédure complète : infra/supervision/mise-en-route.md
# Conduite à tenir   : infra/supervision/conduite-a-tenir.md
# ---------------------------------------------------------------------------

# Jeton d'accès à /api/metrics et /api/observability/alertes.
# Il circule en clair dans l'en-tête : HTTPS obligatoire en production.
# Générer avec : openssl rand -hex 32
GF_METRICS_TOKEN=

# Destination des alertes (POST JSON). Sans elle, le transport webhook est
# inactif et rien ne sort du processus.
GF_ALERT_WEBHOOK=
GF_ALERT_WEBHOOK_TIMEOUT_MS=5000

# Journalisation. En production, le fichier est désactivé par défaut : c'est le
# collecteur de l'infrastructure qui ramasse la sortie standard.
GF_LOG_LEVEL=info
GF_LOG_FILE=

# Répertoire des sauvegardes à surveiller. Sans lui, le composant
# « sauvegarde » est « non_configure » — jamais « ok ».
GF_BACKUP_DIR=

# « dégradé » répond 503 également (retrait systématique du pool).
GF_HEALTH_STRICT=0

# Amorçage des comptes de démonstration (scripts/seed-auth.ts)
# ⚠️ Mot de passe des comptes de démonstration créés par scripts/seed-auth.ts.
#   Il figurait en clair dans ce fichier. Publié dans un dépôt public, il aurait
#   ouvert les comptes d'essai à n'importe qui. La valeur est laissée vide : le
#   script la refuse si elle est absente, plutôt que d'en inventer une.
SEED_DEMO_PASSWORD=

# —————————————————————————————————————————————————————————————
# Stockage des pièces justificatives
# —————————————————————————————————————————————————————————————
# Sans S3_BUCKET, c'est l'adaptateur disque qui est monté. Il écrit dans
# GF_STORAGE_DIR (ou var/storage à défaut) — impossible chez un hébergeur dont
# le système de fichiers est en lecture seule, où le composant « stockage »
# passe « indisponible » et la santé renvoie 503 : une instance incapable de
# conserver une preuve n'a pas à rester dans le pool.
#
# Renseigner les cinq variables ci-dessous monte l'adaptateur S3. Aucune n'a de
# valeur par défaut utile : l'absence de l'une d'elles lève, plutôt que de
# laisser croire à un dépôt qui n'existe pas.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ⚠️ Adressage du compartiment. Deux conventions, et le défaut est la première.
#   « false » (défaut) → style hôte : https://COMPARTIMENT.hôte/cle
#       Le compartiment est préfixé à l'hôte par l'adaptateur. Renseigner
#       l'adresse régionale du service, sans le compartiment :
#         AWS      https://s3.eu-west-1.amazonaws.com
#         Scaleway https://s3.fr-par.scw.cloud
#         OVH      https://s3.gra.cloud.ovh.net
#   « true »       → style chemin : https://hôte/COMPARTIMENT/cle
#       À utiliser si le service l'exige (MinIO, quelques autres) ou si le nom
#       du compartiment n'est pas un nom d'hôte valide.
S3_FORCE_PATH_STYLE=false
