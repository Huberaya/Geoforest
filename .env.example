# Local only. Copy to .env then replace all CHANGE_ME values. Never commit .env.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,frontend,backend
DATABASE_URL=postgresql+psycopg://geoforest_app:CHANGE_ME@db:5432/geoforest
MIGRATION_DATABASE_URL=postgresql+psycopg://geoforest_migrator:CHANGE_ME@db:5432/geoforest
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
MIGRATOR_DB_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
OIDC_ISSUER=http://localhost:3000/identity/realms/geoforest
OIDC_BACKCHANNEL_ORIGIN=http://keycloak:8080
OIDC_CLIENT_ID=geoforest
OIDC_CLIENT_SECRET=CHANGE_ME
KC_BOOTSTRAP_ADMIN_USERNAME=local-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Required in production; must match a genuinely enforced MFA flow at the IdP.
ADMIN_ACR=
SESSION_HOURS=8
API_INTERNAL_URL=http://backend:8000

# Explicit opt-in for public raster reads; production worker isolation must be qualified.
FOREST_ANALYSIS_ENABLED=false

# Native private-vault recipe: disabled until engine, signatures, ownership and backups are provisioned.
# Base Docker image intentionally does not ship a qualified antivirus runtime.
DOCUMENTS_ENABLED=false
DOCUMENT_STORAGE_ROOT=/var/lib/geoforest/documents
CLAMAV_EXECUTABLE=/usr/local/bin/clamscan
CLAMAV_DATABASE=/var/lib/clamav
CLAMAV_LIBRARY_PATH=
DOCUMENT_QUOTA_BYTES=536870912

# Diligence workspace and PDF/JSON/CSV opt-in; requires migration 0007.
DILIGENCE_ENABLED=false

# Production differs from this development example. See docs/deploiement/production.md.
# PUBLIC_ORIGIN: HTTPS origin without trailing slash/path; hostname in ALLOWED_HOSTS.
# OIDC backchannel: HTTPS with an explicitly trusted CA, not the dev HTTP URL above.
# DATABASE_URL: runtime role with ?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.pem
# Use different strong SESSION_SECRET/OIDC_CLIENT_SECRET; never a privileged DB owner.

# Optional Clerk DEVELOPMENT bridge; OIDC remains the default.
AUTH_PROVIDER=oidc
# In clerk_development mode: APP_ENV must not be production, DATABASE_URL
# must point to 127.0.0.1/localhost and a database ending _test (no query overrides).
# Use the SAME PUBLIC_ORIGIN and AUTH_PROVIDER for Next.js and FastAPI.
CLERK_ISSUER=
# Secret: FastAPI only. Never pass to frontend builds or NEXT_PUBLIC_*.
CLERK_SECRET_KEY=
# Publishable key: Next.js only. Must match CLERK_ISSUER and start pk_test_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=true
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true
# ADMIN_ACR stays empty for this development-only bridge; Clerk MFA is not qualified.
# See docs/deploiement/clerk-developpement.md before enabling.
