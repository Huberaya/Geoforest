# GeoForest Trace — Backend environment (copy to .env)
ENVIRONMENT=development
DEBUG=true

# Seed de démo : désactivé par défaut. N'activer qu'en dev avec un secret local de 16+ caractères.
DEMO_SEED_ENABLED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# PostgreSQL (PostGIS) — en dev, docker-compose fournit postgres
# Pour lancer le backend seul (sans docker), utiliser PostgreSQL en local ou SQLite :
#   DATABASE_URL=sqlite+aiosqlite:///./geoforest.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geoforest

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — OBLIGATOIRE en production : 64+ caractères aléatoires
SECRET_KEY=change-me-in-production-use-a-long-random-string-please-32chars

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Emails (portail fournisseur / notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@geoforest-trace.local
# URL publique du frontend (les liens fournisseurs sont placés dans le fragment URL)
APP_URL=http://localhost:3000
SUPPLIER_INVITATION_TTL_HOURS=48
SUPPLIER_MAGIC_LINK_TTL_MINUTES=15

# Stockage objet (S3 ou MinIO)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=geoforest-documents
S3_REGION=eu-west-1

# Global Forest Watch (optionnel; C5 désactivé jusqu'au test de contrat avec une clé autorisée)
GFW_API_KEY=
GFW_API_ORIGIN=
GFW_DATASET=umd_tree_cover_loss
GFW_DATASET_VERSION=v1.13
GFW_CANOPY_THRESHOLD_PCT=10
GFW_SENSITIVITY_CANOPY_THRESHOLD_PCT=30
GFW_LIVE_ENABLED=false
GFW_CONTRACT_VERIFIED=false
# Probe CLI manuel uniquement (ne débloque pas les routes de l'application)
GFW_LIVE_TEST_ENABLED=false
