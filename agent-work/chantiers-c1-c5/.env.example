# Variables d'environnement pour docker-compose (copier vers .env)

# Global Forest Watch (optionnel; C5 désactivé jusqu'au test de contrat avec une clé autorisée)
GFW_API_KEY=
GFW_API_ORIGIN=
GFW_DATASET=umd_tree_cover_loss
GFW_DATASET_VERSION=v1.13
GFW_CANOPY_THRESHOLD_PCT=10
GFW_SENSITIVITY_CANOPY_THRESHOLD_PCT=30
GFW_LIVE_ENABLED=false
GFW_CONTRACT_VERIFIED=false
